{
  "name": "osha52",
  "private": true,
  "description": "OSHA 52 training app (API now; web frontend added in Stage B)",
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm run start -w api",
    "test": "npm test -w api",
    "migrate": "npm run migrate -w api",
    "seed:admin": "npm run seed:admin -w api",
    "check:content": "node scripts/check-answer-length.js --quiet",
    "build": "npm run check:content",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "dev:api": "npm run dev:demo -w api"
  }
}
